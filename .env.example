# ===== Discord =====
DISCORD_TOKEN=

# ===== Bot settings =====
MEMORY_LIMIT=21
TYPING_MIN=6
TYPING_MAX=9
COOLDOWN_SECONDS=120
REQUEST_TIMEOUT=20

# ===== Limits (0 = disabled) =====
USER_LIMIT=10
USER_WINDOW=360
USER_COOLDOWN=15
SERVER_LIMIT=60
SERVER_WINDOW=3600

# 3 slots for Discord user IDs that bypass ALL limits
# (Discord: Settings > Advanced > Developer Mode, then right-click a user > Copy User ID)
UNLIMITED_ID_1=
UNLIMITED_ID_2=
UNLIMITED_ID_3=

# ===== Provider priority (left = tried first) =====
# A provider is used only if it has a key, base URL AND model filled in.
# Trusted first, unverified last. Remove or reorder freely.
PROVIDER_ORDER=groq,mistral,google,nvidia,cohere,cloudflare,zai,openrouter,requesty,vercel,opentyphoon,sealion,aion,kilo,airforce,routeway,novai,kiwi,agnes,arli,mixlayer,merkium,gonka,cheapllm,tokenharbor

# Base URLs/models come from the Free-LLM repo (nejib1/Free-LLM) and change often.
# Blank model = not listed there, check the provider's docs.

# ===== Trusted / first-party =====
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27B

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_MODEL=gemini-3.8-flash

# Cerebras needs a card, so it's disabled
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3-flash

COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1
COHERE_MODEL=command-a-03-2025

# Replace YOUR_ACCOUNT_ID with your Cloudflare account id
CLOUDFLARE_API_KEY=
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.6v-flash

# ===== Gateways =====
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free

REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.requesty.ai/v1
REQUESTY_MODEL=google/gemma-4-31b-it

VERCEL_API_KEY=
VERCEL_BASE_URL=https://ai-gateway.vercel.sh/v1
VERCEL_MODEL=nvidia/nemotron-3.5-lightning-free

KILO_API_KEY=
KILO_BASE_URL=https://ai-gateway.kilo.ai/api/v1
KILO_MODEL=nvidia/nemotron-3.5-lightning:free

# ===== Regional / niche =====
OPENTYPHOON_API_KEY=
OPENTYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
OPENTYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct

SEALION_API_KEY=
SEALION_BASE_URL=https://api.sea-lion.ai/v1
SEALION_MODEL=aisingapore/Qwen-SEA-LION-v4.5-27B-IT

AION_API_KEY=
AION_BASE_URL=https://api.aionlabs.ai/v1
AION_MODEL=aion-labs/aion-2.0

# ===== Unverified (last resort, use throwaway keys) =====
AIRFORCE_API_KEY=
AIRFORCE_BASE_URL=https://api.airforce/v1
AIRFORCE_MODEL=glm-4.7-flash

ROUTEWAY_API_KEY=
ROUTEWAY_BASE_URL=https://api.routeway.ai/v1
ROUTEWAY_MODEL=deepseek-v4.1-flash:free

NOVAI_API_KEY=
NOVAI_BASE_URL=https://aiapi-pro.com/v1
NOVAI_MODEL=glm-4.7-flash

KIWI_API_KEY=
KIWI_BASE_URL=https://api.llm.kiwi/v1
KIWI_MODEL=auto

AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-3.0-flash

ARLI_API_KEY=
ARLI_BASE_URL=https://api.arliai.com/v1
ARLI_MODEL=Qwen3.5-27B-Derestricted

MIXLAYER_API_KEY=
MIXLAYER_BASE_URL=https://models.mixlayer.ai/v1
MIXLAYER_MODEL=qwen/qwen3.5-4b-free

MERKIUM_API_KEY=
MERKIUM_BASE_URL=https://chat.merkium.nl/api/v1
MERKIUM_MODEL=ceres-1.0

GONKA_API_KEY=
GONKA_BASE_URL=https://proxy.gonkabroker.com/v1
GONKA_MODEL=zai-org/GLM-5.3-Flash

CHEAPLLM_API_KEY=
CHEAPLLM_BASE_URL=https://cheapllm.shop/v1
CHEAPLLM_MODEL=deepseek-v4.1-flash-1017

TOKENHARBOR_API_KEY=
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKENHARBOR_MODEL=deepseek-v4.1-flash:free
